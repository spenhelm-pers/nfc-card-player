<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/walnut"
    android:fitsSystemWindows="true">

    <!-- ===== Home: the shelf of tags ===== -->
    <LinearLayout
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
            android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TagTunes"
            android:textColor="@color/cream"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Place a tag on the back of the phone"
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <Button
            android:id="@+id/openPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_home_button_brass"
            android:gravity="center_vertical|start"
            android:minHeight="56dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/volumeCap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_button"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="Volume limit: off"
                android:textAllCaps="false"
                android:textColor="@color/cream_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_button"
                android:minHeight="52dp"
                android:stateListAnimator="@null"
                android:text="Pin app (kid mode)"
                android:textAllCaps="false"
                android:textColor="@color/cream_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shelfLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.12"
            android:text="THE SHELF · TAP A TAG TO EDIT"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/tagList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- ===== Player: "Reading Room" ===== -->
    <LinearLayout
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="Back to the shelf. Press and hold."
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_back"
                android:tint="@color/muted" />

            <TextView
                android:id="@+id/backLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Shelf"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Shelf with the book standing on it; takes whatever height is left -->
        <FrameLayout
            android:id="@+id/shelf"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="200dp">

            <com.spencer.tagtunes.ShelfView
                android:id="@+id/shelfView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/cover"
                android:layout_width="220dp"
                android:layout_height="292dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="22dp"
                android:clipChildren="false">

                <FrameLayout
                    android:id="@+id/bookCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/book_cloth"
                    android:elevation="14dp"
                    android:paddingStart="22dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/book_frame"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/coverTitle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="5"
                            android:lineSpacingMultiplier="1.05"
                            android:textColor="@color/cream"
                            android:textSize="26sp" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1.5dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/brass" />
                    </LinearLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/coverArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cover_art_bg"
                    android:elevation="14dp"
                    android:contentDescription="Cover art"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/trackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textColor="@color/cream"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/trackCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.spencer.tagtunes.LineProgress
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="21dp"
            android:layout_marginEnd="21dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="-11dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/timeElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Previous"
                android:src="@drawable/ic_prev"
                android:tint="@color/cream" />

            <ImageButton
                android:id="@+id/bigPlay"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"
                android:background="@drawable/bg_play"
                android:contentDescription="Play"
                android:elevation="10dp"
                android:padding="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@color/walnut" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Next"
                android:src="@drawable/ic_next"
                android:tint="@color/cream" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/volDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Quieter"
                android:src="@drawable/ic_vol_low"
                android:tint="@color/cream_dim" />

            <com.spencer.tagtunes.LineProgress
                android:id="@+id/volBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/volUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Louder"
                android:src="@drawable/ic_vol_high"
                android:tint="@color/cream_dim" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
