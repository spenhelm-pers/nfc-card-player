<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="4dp" android:bottomLeftRadius="4dp"
                android:topRightRadius="10dp" android:bottomRightRadius="10dp" />
            <solid android:color="@color/cloth_green" />
        </shape>
    </item>
    <!-- darker band where the spine meets the cover -->
    <item android:width="10dp" android:gravity="left">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="4dp" android:bottomLeftRadius="4dp" />
            <solid android:color="#2E000000" />
        </shape>
    </item>
</layer-list>
